{
  "manifest_version": 3,
  "name": "TableSearch",
  "version": "0.1.0",
  "description": "Google results as a sortable table you control: sort by domain, URL or date, choose columns, see exact matches. No account, no API key.",
  "permissions": ["storage"],
  "action": {
    "default_title": "TableSearch: show these results as a table"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Show or hide the results table"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["strings.js", "types.js", "scrape.js", "content.js"],
      "css": ["page.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": ["https://www.google.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
